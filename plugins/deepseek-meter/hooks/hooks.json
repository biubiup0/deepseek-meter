{
  "description": "Show DeepSeek balance and this session's spend when a turn finishes.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 \"$PLUGIN_ROOT/scripts/stop_hook.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
